generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model PanelAccess {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  addedBy   String
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
}

model Guild {
  id             String         @id
  name           String?
  joinedAt       DateTime       @default(now())
  config         GuildConfig?
  currencies     Currency[]
  economyUsers   EconomyUser[]
  coinflipStats  CoinflipStats[]
  birthdays      Birthday[]
  welcome        Welcome?
  goodbye        Goodbye?
  ticketConfig   TicketConfig?
  ticketPanels   TicketPanel[]
  tickets        Ticket[]
}

model GuildConfig {
  guildId                 String   @id
  guild                   Guild    @relation(fields: [guildId], references: [id])
  prefix                  String   @default("/")
  welcomeChannelId        String?
  logChannelId            String?
  logEnabled              Boolean  @default(false)
  modules                 String   @default("fun,utility")
  birthdayEnabled         Boolean  @default(false)
  birthdayChannelId       String?
  birthdayMessage         String   @default("Feliz aniversario, {user}!")
  birthdayRoleId          String?
  birthdayCurrencyId      String?
  birthdayRewardAmount    Int      @default(0)
  birthdayImageUrl        String?
  gamesEnabled            Boolean  @default(true)
  hugEnabled              Boolean  @default(true)
  hugTitle                String   @default("Abraco")
  hugColor                String   @default("#F472B6")
  hugMessage              String   @default("{user} deu um abraco em {target}")
  hugImageUrl             String   @default("https://usagif.com/wp-content/uploads/gif/anime-hug-38.gif")
  hugThumbnail            String?
  hugFooter               String?
  hugTimestamp            Boolean  @default(true)
  slapEnabled             Boolean  @default(true)
  slapTitle               String   @default("Tapa")
  slapColor               String   @default("#ED4245")
  slapMessage             String   @default("{user} deu um tapa em {target}")
  slapImageUrl            String   @default("https://gifdb.com/images/high/up-close-angry-anime-slap-lf84tjs2sgx8obdr.gif")
  slapThumbnail           String?
  slapFooter              String?
  slapTimestamp           Boolean  @default(true)
  kissEnabled             Boolean  @default(true)
  kissTitle               String   @default("Beijo")
  kissColor               String   @default("#F472B6")
  kissMessage             String   @default("{user} deu um beijo em {target}")
  kissImageUrl            String   @default("https://i.pinimg.com/originals/37/df/fe/37dffeecf1a6162e5c6526bfa65b1ca1.gif")
  kissThumbnail           String?
  kissFooter              String?
  kissTimestamp           Boolean  @default(true)
  blockedCommandChannels  String?
  blockedCommandMessage   String   @default("Voce nao pode executar comandos neste canal!")
  blockedCommandNotify    Boolean  @default(true)
  blockedCommandAsEmbed   Boolean  @default(false)
  counterEnabled          Boolean  @default(false)
  counterChannelId        String?
  counterTemplate         String   @default("Membros: {contmember}")
  language                String   @default("pt-BR")
  timezone                String   @default("America/Sao_Paulo")
  autoroleId              String?
  inviteLink              String?
  automodEnabled          Boolean  @default(false)
  automodBannedWords      String?
  automodLinkBlocklist    String?
  automodLinkWhitelist    String?
  automodBypassRoles      String?
  automodBypassUsers      String?
  automodIgnoredChannels  String?
  automodMaxMentions      Int      @default(5)
  automodMaxLines         Int      @default(15)
  automodMaxZalgo         Boolean  @default(true)
  automodInviteBlock      Boolean  @default(true)
  automodLogChannel       String?
  automodAction           String   @default("delete")
  automodWarnThreshold    Int      @default(3)
  automodMuteDuration     Int      @default(300)
}

model ActivityLog {
  id        String   @id @default(uuid())
  guildId   String
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model Currency {
  id            String         @id @default(uuid())
  guildId       String
  guild         Guild          @relation(fields: [guildId], references: [id])
  name          String
  symbol        String         @default("$")
  taxRate       Float          @default(0)
  exchangeRate  Float          @default(1.0)
  isPrimary     Boolean        @default(false)
  transferable  Boolean        @default(true)   // pode ser enviada com /pay
  economyUsers  EconomyUser[]
  gameCurrencies GameCurrency[]
  shopItems     ShopItem[]

  @@unique([guildId, name])
}

model EconomyUser {
  id         String   @id @default(uuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id])
  userId     String
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  balance    Int      @default(0)
  bank       Int      @default(0)
  lastDaily  DateTime?
  lastWork   DateTime?

  @@unique([guildId, userId, currencyId])
}

model CoinflipStats {
  id      String @id @default(uuid())
  guildId String
  userId  String
  wins    Int    @default(0)
  total   Int    @default(0)
  guild   Guild  @relation(fields: [guildId], references: [id])

  @@unique([guildId, userId])
}

model GameConfig {
  id          String   @id @default(uuid())
  guildId     String
  gameName    String
  enabled     Boolean  @default(true)
  minBet      Int      @default(10)
  maxBet      Int      @default(1000)
  reward      Int      @default(100)
  dailyLimit  Int      @default(0)

  currencyMode String  @default("single")

  currencies  GameCurrency[]

  @@unique([guildId, gameName])
}


model GameCurrency {
  id           String     @id @default(uuid())
  gameConfigId String
  gameConfig   GameConfig @relation(fields: [gameConfigId], references: [id], onDelete: Cascade)
  currencyId   String
  currency     Currency   @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  minBet       Int?    
  maxBet       Int?
  reward       Int?

  @@unique([gameConfigId, currencyId])
}

model Birthday {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  day       Int
  month     Int
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id])

  @@unique([guildId, userId])
}

model GameTransaction {
  id         String   @id @default(uuid())
  guildId    String
  userId     String
  gameName   String
  currencyId String?
  bet        Int
  result     String
  reward     Int
  createdAt  DateTime @default(now())
}

model DailyGameUsage {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  gameName  String
  uses      Int      @default(0)
  date      DateTime @default(now())

  @@unique([guildId, userId, gameName, date])
}

model ModAction {
  id          String   @id @default(uuid())
  guildId     String
  userId      String?
  moderatorId String
  action      String
  reason      String?
  duration    Int?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
}

model LevelUser {
  id      String @id @default(uuid())
  guildId String
  userId  String
  xp      Int    @default(0)
  level   Int    @default(0)

  @@unique([guildId, userId])
}

model LevelConfig {
  guildId              String   @id
  enabled              Boolean  @default(true)
  message              String   @default("{user} subiu para o nivel {level}!")
  imageUrl             String?
  rewardCurrencyId     String?
  rewardAmount         Int      @default(0)
  channelMultipliers   String?
  roleMultipliers      String?
  blockedChannels      String?
  blockedRoles         String?
  roleByLevel          String?
  xpMode               String   @default("formula")
  baseXP               Int      @default(100)
  exponent             Float    @default(2.0)
  minXpPerMessage      Int      @default(15)
  maxXpPerMessage      Int      @default(25)
  cooldownSeconds      Int      @default(60)
  levelUpChannelId     String?
  dailyXpLimit         Int      @default(0)
}

model LevelRequirement {
  id        String @id @default(uuid())
  guildId   String
  level     Int
  xpNeeded  Int

  @@unique([guildId, level])
}

model LevelReward {
  id           String  @id @default(uuid())
  guildId      String
  level        Int
  roleId       String?
  currencyId   String?
  rewardAmount Int     @default(0)
  imageUrl     String?
  message      String?
}

model DailyXp {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  xp        Int      @default(0)
  date      DateTime @default(now())

  @@unique([guildId, userId, date])
}

model Welcome {
  guildId      String   @id
  channelId    String?
  message      String?
  enabled      Boolean  @default(true)
  autoroleId   String?
  templateJson Json?
  bgImage      String?
  sendType     String?  @default("image_embed")
  embedJson    Json?
  buttonsJson  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model Goodbye {
  guildId      String   @id
  channelId    String?
  message      String?
  enabled      Boolean  @default(true)
  sendType     String?  @default("text_only")
  embedJson    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model TicketConfig {
  guildId      String        @id
  enabled      Boolean       @default(false)
  panels       TicketPanel[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  guild        Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model TicketPanel {
  id                String        @id @default(uuid())
  guildId           String
  name              String        @default("Novo Painel")
  description       String?
  categoryId        String?
  channelId         String?
  sendType          String        @default("panel")
  ticketButtonsJson Json?
  openMessage       String?
  embedJson         Json?
  componentsJson    Json?
  ticketMessage        String?
  ticketEmbedJson      Json?
  ticketComponentsJson Json?
  closeMessage      String?
  staffRoles        String?
  addRolesOnOpen    String?
  removeRolesOnOpen String?
  buttonsJson       String?
  ticketChannelName String        @default("ticket-{count}")
  maxTickets        Int           @default(5)
  ticketLimit       Int           @default(1)
  enabled           Boolean       @default(true)
  closeInTwoSteps   Boolean       @default(false)
  ticketPadding     Int           @default(4)
  moderatorOptionsJson Json?
  permissionsJson Json?
  formsJson       Json?
  limitsJson      Json?
  messagesJson    Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  config            TicketConfig  @relation(fields: [guildId], references: [guildId], onDelete: Cascade, map: "TicketPanel_config_fkey")
  guild             Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade, map: "TicketPanel_guild_fkey")
  tickets           Ticket[]
  @@unique([guildId, id])
}

model Ticket {
  id           String        @id @default(uuid())
  guildId      String
  panelId      String
  userId       String
  channelId    String
  status       String        @default("open")
  createdAt    DateTime      @default(now())
  closedAt     DateTime?
  closedBy     String?
  panel        TicketPanel   @relation(fields: [panelId], references: [id], onDelete: Cascade)
  guild        Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
}
model BotHeartbeat {
  id            String   @id
  status        String   @default("offline")
  clientId      String?
  tag           String?
  guildCount    Int      @default(0)
  userCount     Int      @default(0)
  ping          Int      @default(0)
  uptimeSeconds Int      @default(0)
  startedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model Report {
  id            String   @id @default(uuid())
  guildId       String
  reporterId    String
  targetId      String
  reason        String
  description   String?
  imageUrl      String?
  status        String   @default("pending") // pending | resolved | ignored
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([guildId, status])
  @@index([guildId, createdAt])
}

model ReportConfig {
  guildId      String   @id
  enabled      Boolean  @default(false)
  channelId    String?
  mentionStaff Boolean  @default(true)
  staffRoleId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model Suggestion {
  id            String   @id @default(uuid())
  guildId       String
  authorId      String
  title         String
  description   String
  status        String   @default("pending")
  upvotes       Int      @default(0)
  downvotes     Int      @default(0)
  messageId     String?
  channelId     String?
  staffComment  String?
  reviewedBy    String?
  reviewedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  votes         SuggestionVote[]

  @@index([guildId, status])
  @@index([guildId, createdAt])
}

model SuggestionConfig {
  guildId         String   @id
  enabled         Boolean  @default(false)
  channelId       String?
  anonymous       Boolean  @default(false)
  autoApprove     Boolean  @default(false)
  duration        String   @default("1d")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SuggestionVote {
  id            String   @id @default(uuid())
  suggestionId  String
  userId        String
  voteType      String
  createdAt     DateTime @default(now())

  suggestion    Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
  @@index([suggestionId])
}

// ===================== ECONOMIA (config, loja, staff) =====================

model EconomyConfig {
  guildId             String   @id
  dailyAmount         Int      @default(100)
  dailyCooldownHours  Int      @default(24)
  workEnabled         Boolean  @default(true)
  workMin             Int      @default(50)
  workMax             Int      @default(150)
  workCooldownMinutes Int      @default(60)
  bankEnabled         Boolean  @default(true)
  staffLogChannelId   String?
  updatedAt           DateTime @updatedAt
}

model ShopItem {
  id           String   @id @default(uuid())
  guildId      String
  name         String
  description  String?
  price        Int
  currencyId   String
  currency     Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  roleId       String
  durationDays Int?     // vazio = cargo permanente
  stock        Int?     // vazio = estoque ilimitado
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([guildId])
}

model TemporaryRole {
  id        String   @id @default(uuid())
  guildId   String
  userId    String
  roleId    String
  itemId    String?
  expiresAt DateTime
  removed   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([guildId, userId, roleId])
  @@index([removed, expiresAt])
}

model EconomyLog {
  id          String   @id @default(uuid())
  guildId     String
  userId      String
  moderatorId String
  currencyId  String
  amount      Int      // positivo = adicionou, negativo = removeu
  reason      String?
  source      String   @default("bot") // bot | painel
  createdAt   DateTime @default(now())

  @@index([guildId, createdAt])
}

// ===================== DIVULGAÇÃO DE SERVIDORES =====================

model ServerListing {
  guildId           String    @id
  enabled           Boolean   @default(false)
  // Dados do servidor (atualizados pelo bot e pelo painel)
  name              String?
  icon              String?
  banner            String?
  memberCount       Int       @default(0)
  onlineCount       Int       @default(0)
  // O que o dono escreve no painel
  shortDescription  String?
  description       String?
  tags              String[]  @default([])
  category          String    @default("comunidade")
  language          String    @default("pt-BR")
  nsfw              Boolean   @default(false)
  // Convite criado pelo bot
  inviteChannelId   String?
  inviteCode        String?
  // Bump
  bumpChannelId     String?   // canal do aviso "bump liberado" (vazio = onde usaram o /bump)
  lastBumpChannelId String?
  bumpedAt          DateTime?
  bumpedBy          String?
  bumpCount         Int       @default(0)
  bumpReminded      Boolean   @default(true)
  // Moderação (você, pelo /admin/divulgacao)
  hidden            Boolean   @default(false)
  hiddenReason      String?
  hiddenBy          String?   // ID do admin que ocultou
  hiddenAt          DateTime?
  syncedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  votes             ServerVote[]
  reports           ServerListingReport[]

  @@index([enabled, hidden, bumpedAt])
}

model ServerVote {
  id        String        @id @default(uuid())
  guildId   String
  listing   ServerListing @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  userId    String
  createdAt DateTime      @default(now())

  @@index([guildId, createdAt])
  @@index([userId, guildId, createdAt])
}

model ServerListingReport {
  id         String        @id @default(uuid())
  guildId    String
  listing    ServerListing @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  reporterId String
  reason     String
  details    String?
  resolved   Boolean       @default(false)
  resolution String?       // ocultado | marcado_18 | ignorado
  resolvedBy String?       // ID do admin que decidiu
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([resolved, createdAt])
}

// Histórico de decisões da moderação da divulgação
model ListingModerationLog {
  id        String   @id @default(uuid())
  guildId   String
  adminId   String
  action    String   // ocultou | mostrou | marcou_18 | ignorou
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Cache da lista de servidores de cada usuário (vinda do Discord).
// Compartilhado entre todas as cópias do painel na Vercel, para não
// estourar o limite de requisições do Discord.
model DiscordUserGuilds {
  userId    String   @id
  guilds    Json
  fetchedAt DateTime @default(now())
}

// ===================== LOJA BYTEUP (produtos digitais) =====================

model StoreProduct {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  shortDescription String   @default("")
  description      String   @default("")
  category         String   @default("bot") // bot | plugin | app | servico
  kind             String   @default("download") // download | servico (atendido por ticket)
  priceCents       Int      @default(0)
  imageKey         String?  // imagem de capa no R2
  active           Boolean  @default(false) // só aparece na loja quando ativo
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  files            StoreProductFile[]
  orderItems       StoreOrderItem[]

  @@index([active, sortOrder])
}

// Arquivo de entrega guardado no Cloudflare R2 (pode ter vários GB)
model StoreProductFile {
  id          String       @id @default(uuid())
  productId   String
  product     StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  key         String       @unique // caminho no R2
  fileName    String
  sizeBytes   BigInt       @default(0)
  contentType String       @default("application/octet-stream")
  status      String       @default("uploading") // uploading | ready
  uploadId    String?      // upload multipart em andamento
  createdAt   DateTime     @default(now())

  @@index([productId, status])
}

model StoreOrder {
  id          String    @id @default(uuid())
  userId      String    // ID do Discord de quem comprou
  status      String    @default("pending") // pending | paid | failed | cancelled | refunded
  provider    String?   // mercadopago | stripe
  providerRef String?   // ID do pagamento no provedor
  checkoutUrl String?
  totalCents  Int
  currency    String    @default("BRL")
  paidAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       StoreOrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@unique([provider, providerRef])
}

model StoreOrderItem {
  id           String        @id @default(uuid())
  orderId      String
  order        StoreOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      StoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  nameSnapshot String        // nome do produto no momento da compra
  priceCents   Int
  options      Json?         // "monte o seu": comandos escolhidos
  buildKey     String?       // .zip personalizado gerado no R2

  @@index([orderId])
  @@index([productId])
}
